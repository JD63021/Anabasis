+__global__ static void kernel_copy_plus_hypre_solution(
+    int n,
+    double *out,
+    const double *oldx,
+    const HYPRE_Complex *dx)
+{
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if(i >= n) return;
+  out[i] = oldx[i] + (double)dx[i];
+}
