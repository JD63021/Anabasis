# ======================================================================
# Anabasis v1.1d-final — reference steady SIMPLE cylinder benchmark
# ======================================================================
# Expected patches:
#   patch_0_0 = channel walls
#   patch_1_0 = inlet
#   patch_2_0 = outlet
#   patch_3_0 = cylinder wall / force patch
#
# This is the validated steady Re≈20-style cylinder case.  The inlet
# parameter Um=0.45 gives cross-section average Ubar=(4/9)Um=0.2, so
# Re=Ubar*D/mu=20 for D=0.1, rho=1, mu=0.001.
# ======================================================================

# [mesh/output]
polyMeshDir /tmp/meshCase/constant/polyMesh
outPrefix runs/simple_cylinder_re20/case

device 0
writeVtu 1
writeEvery 0
monitor 1
profileSteps 0

# [physics/fluid]
rho 1.0
mu 0.001
Umean 0.45

# Reference dimensions used by the cylinder force coefficient postprocess.
pipeD 0.1
pipeL 2.5

# [patch aliases]
wallPatch patch_0_0
inletPatch patch_1_0
outletPatch patch_2_0

# [SIMPLE controls]
nsteps 500
printEvery 10
corrTol 1e-10
tolMass 1e-9
tolVel 1e-9

uRelax 0.7
pRelax 0.3

# [geometry / reconstruction]
geomMethod robust
lsqStencil compact
lsqWeightPower 1

# [pressure-velocity coupling]
pMode absolute
pSolveMode ofAbsolute
rcMode oflike
pGradScheme lsq
rAUMode raw
pCoeffScale 1
pDeltaMode of
pDeltaMinCos 0.05

# [momentum / pressure discretization]
momNonOrthScale 0
momentumConvectionScheme central
pNonOrthScale 0
nVelNonOrthCorr 0
nNonOrthCorr 0
nPressureCorr 0

# [initialization]
initMode uniform
potentialInitRAU 1.0
potentialInitMaxit 4000
potentialInitTol 1e-10
potentialInitRelTol 0.0
potentialInitWrite 0

# [linear solvers]
velMaxit 2000
velTol 0
velRelTol 1e-10

pUseAmg 1
pMaxit 4000
pTol 1e-12
pRelTol 0.0
pAmgCoarsenType 8
pAmgInterpType 6
pAmgAggLevels 1
pAmgRelaxType 7
pAmgKeepTranspose 1
pAmgRebuildEvery 1

# [Poisson module options]
poissonGradientScheme gauss
poissonLaplacianScheme nonorth
poissonNonOrthCorr 2

# [Scalar transport module options]
scalarEnable 0
scalarSolveMode afterFlow
scalarName T
scalarConvectionScheme upwind
scalarDiffusionScheme nonorth
scalarGamma 1.0
scalarRelax 1.0
scalarNonOrthCorr 2
scalarMaxit 4000
scalarTol 1e-10
scalarRelTol 0.0

# [velocity boundary conditions]
velocity patch_0_0 wall_noslip
velocity patch_3_0 wall_noslip
velocity patch_1_0 parabolic_box_inlet 0.41 0.45 y z average_patch_normal
velocity patch_2_0 zero_gradient

# [pressure boundary conditions]
pressure patch_0_0 zero_gradient
pressure patch_3_0 zero_gradient
pressure patch_1_0 zero_gradient
pressure patch_2_0 fixed_value 0.0

# [force postprocessing]
forceEnable 1
forcePatch patch_3_0
forceNormalSign -1
forceUref 0.2
forceAreaRef 0.041
forceDragDir 1,0,0
forceLiftDir 0,0,1
forceSpanDir 0,1,0

# [diagnostics]
badCellAuditEvery 0
badCellAuditTop 15
badCellAuditStart 1
badCellAuditOnGrowth 0
badCellAuditGrowthFactor 1.2
badCellAuditMassFloor 1e-8
badCellAuditWriteCsv 0
