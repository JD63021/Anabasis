polyMeshDir /home/jd/Desktop/meshes/industrial1/constant/polyMesh
outPrefix /home/jd/anabasis_v0/runs/regression_checks/industrial1

rho 1.0
mu 1e5
uMean 1e-3
pipeD 1.0
pipeL 1.0

wallPatch patch_0_0
inletPatch patch_2_0
outletPatch patch_3_0

nsteps 1000
printEvery 1
monitor 1
writeVtu 1
writeEvery 0

corrTol 1e-5
tolMass 1e-3
tolVel 1e-3

uRelax 0.7
pRelax 0.3

pMode absolute
pSolveMode ofAbsolute
rcMode oflike
pGradScheme lsq
rAUMode raw
pCoeffScale 1
pDeltaMode of
pDeltaMinCos 0.05

momNonOrthScale 1
pNonOrthScale 1
nVelNonOrthCorr 0
nNonOrthCorr 0
nPressureCorr 0

momentumConvectionScheme central

simpleMmsEnable 0
simpleMmsPressurePenaltyCoeff 0

simpleFaceSkewCorr 1
simpleSubtriContinuity 1
simpleSubtriFluxRecon 1

velSolver mcgs-fused
velMaxit 10
velTol 1e-3
velRelTol 0

pUseAmg 1
pMaxit 2000
pTol 1e-7
pRelTol 0

pAmgCoarsenType 8
pAmgInterpType 6
pAmgAggLevels 1
pAmgRelaxType 7
pAmgKeepTranspose 1
pAmgRebuildEvery 1000

forceEnable 0
forcePatch patch_3_0
forceNormalSign -1
forceUref 1.0
forceAreaRef 1.0
forceDragDir 1,0,0
forceLiftDir 0,1,0
forceSpanDir 0,0,1

velocity patch_0_1 wall_noslip
