# Snappy/CfdOF cylinder transient PIMPLE smoke test

polyMeshDir /tmp/meshCase/constant/polyMesh
outPrefix runs/test2_import/case

device 0
writeVtu 1
writeEvery 0
monitor 1
profileSteps 0

startTime 0.0
dt 0.001
nsteps 25
printEvery 1
nOuterCorrectors 3
nCorrectors 2
momentumPredictor 1
transientMomentum 1
timeScheme BDF2

rho 1.0
mu 0.001
Umean 2.25
pipeD 0.1
pipeL 2.5

wallPatch patch_0_0
inletPatch patch_1_0
outletPatch patch_2_0

corrTol 1e-10
tolMass 1e-7
tolVel 1e-7

uRelax 0.7
pRelax 0.3
uRelaxFinal 0.7
pRelaxFinal 0.3

geomMethod robust
lsqStencil compact
lsqWeightPower 1

pMode absolute
pSolveMode ofAbsolute
rcMode oflike
pGradScheme gauss
rAUMode raw
pCoeffScale 1
pDeltaMode of
pDeltaMinCos 0.1

momNonOrthScale 0
momentumConvectionScheme central
pNonOrthScale 0
nVelNonOrthCorr 0
nNonOrthCorr 0
nPressureCorr 0

initMode uniform
potentialInitRAU 1.0
potentialInitMaxit 4000
potentialInitTol 1e-10
potentialInitRelTol 0.0
potentialInitWrite 0

velMaxit 2000
velTol 1e-10
velRelTol 1e-6
velMaxitFinal 3000
velTolFinal 1e-10
velRelTolFinal 1e-8

pUseAmg 1
pMaxit 8000
pTol 1e-8
pRelTol 1e-6
pMaxitFinal 8000
pTolFinal 1e-9
pRelTolFinal 1e-6
pAmgCoarsenType 8
pAmgInterpType 6
pAmgAggLevels 1
pAmgRelaxType 7
pAmgKeepTranspose 1
pAmgRebuildEvery 1

poissonGradientScheme gauss
poissonLaplacianScheme nonorth
poissonNonOrthCorr 2

scalarEnable 0
scalarSolveMode afterFlow
scalarName T
scalarConvectionScheme upwind
scalarDiffusionScheme nonorth
scalarGamma 1.0
scalarRelax 1.0
scalarNonOrthCorr 2
scalarMaxit 4000
scalarTol 1e-10
scalarRelTol 0.0

velocity patch_0_0 wall_noslip
velocity patch_3_1 wall_noslip
velocity patch_1_0 parabolic_box_sine_inlet 0.41 2.25 y z 8.0 average_patch_normal
velocity patch_2_0 zero_gradient

pressure patch_0_0 zero_gradient
pressure patch_3_1 zero_gradient
pressure patch_1_0 zero_gradient
pressure patch_2_0 fixed_value 0.0

forceEnable 1
forcePatch patch_3_1
forceEvery 1
forceLogPath runs/test2_import/case_force_timeseries.csv
forceLogAppend 0
forceNormalSign -1
forceUref 1.0
forceAreaRef 0.041
forceDragDir 1,0,0
forceLiftDir 0,0,1
forceSpanDir 0,1,0

badCellAuditEvery 0
badCellAuditTop 15
badCellAuditStart 1
badCellAuditOnGrowth 0
badCellAuditGrowthFactor 1.2
badCellAuditMassFloor 1e-8
badCellAuditWriteCsv 0
