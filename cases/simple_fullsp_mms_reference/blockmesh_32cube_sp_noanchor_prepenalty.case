polyMeshDir /home/jd/Desktop/meshes/unitcube/blockmesh/32cube/constant/polyMesh
outPrefix /home/jd/anabasis_v0/runs/simple_fullsp_mms_reference/blockmesh_32cube_sp_noanchor_prepenalty

nsteps 1000
printEvery 25
monitor 0

corrTol 1e-10
tolMass 1e-6
tolVel 1e-6

uRelax 0.7
pRelax 0.3

pMode pcorr
pSolveMode ofAbsolute
rcMode old
pGradScheme lsq
rAUMode relaxed
pCoeffScale 1
pDeltaMode of
